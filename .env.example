# Copia in .env e adatta. Tutte le variabili hanno un default.

# --- LLM (endpoint OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:11434/v1     # Ollama. Splash: http://127.0.0.1:8000/v1  LM Studio: http://localhost:1234/v1
LLM_MODEL=gemma4:26b                       # Splash: mlx-community/Qwen3.8-27B-4bit
LLM_TEMPERATURE=0.4
# Di default viene inviato {"reasoning_effort": "none"} per spegnere il thinking (Ollama e Splash).
# LLM_EXTRA_BODY={}                        # lascia il thinking acceso (lento: non consigliato per la voce)
# LLM_JSON_MODE=0                          # metti 0 con Splash o se il server rifiuta response_format

# --- STT ---
# STT_BACKEND=mlx                         # "mlx" = Whisper in-process (Apple Silicon); "openai" = endpoint /audio/transcriptions
STT_MODEL=mlx-community/whisper-large-v3-turbo
# STT_BASE_URL=http://localhost:9000/v1   # solo con STT_BACKEND=openai
# AUDIO_MIN_SECONDS=0.4                   # audio più breve o più silenzioso (AUDIO_MIN_RMS=0.004) non va a Whisper
# STT_INITIAL_PROMPT=Conversation about software: Ollama, FastAPI, React, pip install.

# --- Valutazione fonetica della pronuncia (Wav2Vec2 XLSR-53 su MPS; richiede espeak-ng) ---
# PHONETIC_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft
# PHONETIC_DEVICE=mps                      # "cpu" se MPS non è disponibile

# --- TTS: il tuo openai-macos-stt-tts (porta 5050; nel suo .env metti USE_HTTP=True per usare http) ---
# TTS_BASE_URL=http://localhost:5050/v1
# TTS_VOICE_EN=nova                        # voci OpenAI mappate su voci macOS in config.py del tuo servizio
# TTS_VOICE_IT=alloy
